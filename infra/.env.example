# ---------------------------------------------------------------------------
# Copier en infra/.env et adapter. Ce fichier .env n'est JAMAIS versionné.
# ---------------------------------------------------------------------------

# PostgreSQL — instance unique, deux bases (airflow + eckert)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Rôles applicatifs de l'entrepôt eckert
ELT_ADMIN_PASSWORD=changeme_admin
ELT_WRITER_PASSWORD=changeme_writer
ELT_READER_PASSWORD=changeme_reader

# MinIO (stockage objet, couche bronze)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_BUCKET=eckert-bronze
MINIO_ENDPOINT=http://minio:9000

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme_airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=changeme_secret

# Alerting (C4.3.1) — laisser vide pour désactiver l'envoi réel
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=data-eckert@example.local

# Source de données
DATAGOUV_DATASET=fichier-des-personnes-decedees
DATAGOUV_API=https://www.data.gouv.fr/api/1/datasets
